datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  icon        String?
  status      String   @default("active")
  canvases    Canvas[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Canvas {
  id              String             @id @default(cuid())
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String             @default("Untitled Canvas")
  order           Int                @default(0)
  documentContent Json?
  canvasBlocks    CanvasBlock[]
  shareTokens     CanvasShareToken[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([projectId, order])
}

model CanvasShareToken {
  id        String    @id @default(cuid())
  token     String    @unique
  canvasId  String
  canvas    Canvas    @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([canvasId])
}

model CanvasBlock {
  id        String   @id @default(cuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  order     Int
  type      String
  x         Float
  y         Float
  width     Float
  height    Float
  content   Json
  color     String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canvasId, order])
}
